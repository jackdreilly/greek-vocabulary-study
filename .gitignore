/data/

# Local packaging scratch
.artifacts/
*.zip

# Migration / Firebase debug
.migration-progress.json
firebase-debug.log
firestore-debug.log
ui-debug.log

# Secrets
.env
.env.local
service-account-key.json
*-service-account*.json
